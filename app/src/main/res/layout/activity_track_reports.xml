<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/track_reports_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ab_surface"
    tools:context=".TrackReportsActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:text="@string/brand_name"
        android:textColor="@color/ab_navy"
        android:textSize="24sp"
        android:textStyle="bold"
        android:importantForAccessibility="no" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/ab_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Track your reports"
                android:textColor="@color/ab_navy"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="View your submitted reports and their status."
                android:textColor="@color/ab_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/track_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="64dp"
                android:paddingBottom="64dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_track"
                    app:tint="@color/ab_muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="No reports yet"
                    android:textColor="@color/ab_navy"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Your reports will appear here after you submit one."
                    android:textColor="@color/ab_muted"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_go_to_report"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minWidth="200dp"
                    android:minHeight="56dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="Go to Report"
                    android:textAllCaps="false"
                    android:textColor="@color/ab_surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/ab_navy"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/reports_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ab_line"
        android:importantForAccessibility="no" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/resident_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/ab_surface"
        app:elevation="0dp"
        app:menu="@menu/resident_navigation"
        app:labelVisibilityMode="labeled"
        app:itemHorizontalTranslationEnabled="false"
        app:itemBackground="@drawable/nav_item_background"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemPaddingTop="12dp"
        app:itemPaddingBottom="12dp"
        app:itemActiveIndicatorStyle="@null" />

</LinearLayout>